<% layout("/layouts/boilerplate") %>

<div class="container py-5">

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-lg border-0">
                <div class="card-body p-5">
                    <div class="text-center">
                        <% if(poll.status === "closed"){ %>
                            <span class="badge bg-success mb-3">POLL CLOSED </span>
                        <% } else { %>
                            <span class="badge bg-success mb-3">LIVE POLL </span>
                        <%} %>
                       
                        <h1 class="mb-4">
                            <%= poll.question %>
                        </h1>
                    </div>

                    <!-- Timer -->

                    <div class="alert alert-warning text-center">

                         ⏱ Time Remaining:
                        <strong id="countdown"> Loading...</strong>

                    </div>

                    <!-- Poll Type -->

                    <div class="text-center mb-4">

                        <span class="badge bg-primary">

                            <%= poll.pollType %>

                        </span>

                    </div>

 <!-- voting section -->
<h4 class="mb-3"> Vote Now</h4>
<% poll.options.forEach(option => { %>
    <form action="/poll/<%= poll._id %>/vote"method="POST"class="mb-2">
        <input type="hidden" name="optionId" value="<%= option._id %>">
        <button type="submit"class="btn btn-outline-primary w-100 d-flex justify-content-between align-items-center vote-btn">
            <%= option.text %> (<%= option.votes %>)
            <span><%= option.text %></span>
            <span class="badge bg-primary"><%= option.votes %></span>
        </button>
    </form>

<% }) %>
          
<!-- Total votes  -->
<div class="text-center mt-4">
    <h5>Total votes: <span class="badge bg-dark"><%= poll.totalVotes %></span></h5>
</div>

<!-- result button  -->
<div class="text-center mt-4">
    <a  href="/poll/<%= poll._id %>/results" class="btn btn-success">View Results</a>
</div>

<!-- Copy Alert -->
 <div id="copyAlert" class="alert alert-success d-none"> Poll link copied successfully! you can share it</div>

<!-- Share Link -->
<h5> Share Poll</h5>
    <div class="input-group">
    <input type="text" id="pollLink" class="form-control"value="<%= `${req.protocol}://${req.get('host')}/poll/${poll._id}` %>"readonly>
    <button id="copyBtn" class="btn btn-primary">Copy link</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="/js/script.js"></script>

<script>
    const expiresAt =
    new Date("<%= poll.expiresAt.toISOString() %>");

    function updateTimer() {

    const now = new Date();

    const difference =
        expiresAt - now;

    if (difference <= 0) {

        document.getElementById( "countdown").innerText = "Poll Closed";
        const voteButtons = document.querySelectorAll(".vote-btn");
        voteButtons.forEach(button => {
            button.disabled = true;
        });
        clearInterval(timeInterval);
        return;
    }

    const seconds =
        Math.floor(difference / 1000);

    document.getElementById(
        "countdown"
    ).innerText =
        seconds + " seconds";

}

updateTimer();

const timeInterval = setInterval(updateTimer, 1000);
</script>
