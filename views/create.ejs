 <% layout("/layouts/boilerplate") %> 

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0">
                <div class="card-body p-4">
                    <h1 class="text-center mb-4"> Create New Poll </h1>
                    <form action="/poll" method="POST">
                        <!-- Question -->
                         <div class="mb-4">
                            <label class="form-label fw-bold">Poll Question </label>
                            <input
                                type="text"
                                class="form-control"
                                name="question"
                                placeholder="Enter your poll question"
                                required>
                            </div>
                            <!-- poll type  -->
                             <div class="mb-3">
                            <label class="form-label">
                                Poll Type
                            </label>

                            <select
                                class="form-select"
                                name="pollType"
                                id="pollType"
                            >
                                <option value="multiple">
                                    Multiple Choice
                                </option>

                                <option value="yesno">
                                    Yes / No Poll
                                </option>

                                <option value="truefalse">
                                    True / False Poll
                                </option>

                            </select>
                        </div>
                        <!-- Options -->
                         <!-- Options -->

                        <div id="optionsSection">

                            <label class="form-label">
                                Options
                            </label>

                            <div id="optionsContainer">

                                <input
                                    type="text"
                                    class="form-control mb-2"
                                    name="options"
                                    placeholder="Option 1"
                                >

                                <input
                                    type="text"
                                    class="form-control mb-2"
                                    name="options"
                                    placeholder="Option 2"
                                >

                            </div>

                            <button
                                type="button"
                                class="btn btn-outline-primary"
                                id="addOptionBtn"
                            >
                                + Add Option
                            </button>

                        </div>

                        <!-- <div class="mb-4">
                            <label class="form-label fw-bold">Poll Options</label>
                            <input
                                type="text"
                                class="form-control mb-2"
                                name="options"
                                placeholder="Option 1"
                                required
                            >
                            <input
                                type="text"
                                class="form-control mb-2"
                                name="options"
                                placeholder="Option 2"
                                required
                            >
                            <input
                                type="text"
                                class="form-control mb-2"
                                name="options"
                                placeholder="Option 3"
                            >
                            <input
                                type="text"
                                class="form-control"
                                name="options"
                                placeholder="Option 4"
                            >
                        </div> -->

                        <!-- Timer -->

                        <div class="mb-4">
                            <label class="form-label fw-bold">Poll Duration (Seconds)</label>
                             <input
                                type="number"
                                class="form-control"
                                name="timer"
                                value="60"
                                min="10"
                                required
                            >
                        </div>

<!-- Chart Type -->
 <div class="mb-4">
    <label class="form-label fw-bold">Chart Type</label>
    <select class="form-select"name="chartType">

                                <option value="bar">
                                    Bar Chart
                                </option>

                                <option value="pie">
                                    Pie Chart
                                </option>

                                <option value="doughnut">
                                    Doughnut Chart
                                </option>

                            </select>

                        </div>

                        <!-- Submit -->
                         <button type="submit"class="btn btn-primary w-100">Create Poll</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="/js/script.js"></script>




